<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FitMate.Core\FitMate.Core.csproj" />
    <ProjectReference Include="..\FitMate.DB\FitMate.DB.csproj" />
    <ProjectReference Include="..\FitMate.Services\FitMate.Services.csproj" />
    <ProjectReference Include="..\FitMate.Integrations\FitMate.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.15.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    <PackageReference Include="Reinforced.Typings" Version="1.6.5" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.24.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.4.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="SeedData\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <UserSecretsId>FitMate.Web-50df1e43-4d0e-4ef0-ad9f-6f6dc08023eb</UserSecretsId>
  </PropertyGroup>

  <!-- Baked into the assembly so a running container can report which build it is, and read back
       through AssemblyMetadata at /api/admin/build-info. GIT_COMMIT is optional: Railway can inject
       it as a build arg, and the endpoint just omits the SHA when it is missing. -->
  <PropertyGroup>
    <BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("O"))</BuildTimestampUtc>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
  </ItemGroup>

</Project>
